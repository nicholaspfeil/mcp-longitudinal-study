# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# Environment / secrets — never commit these
.env
.env.*
*.key

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/

# Scratch — anything here is disposable
scratch/
*.tmp

# NOTE: data/ is deliberately NOT ignored.
# The observation record is the point of this repository. It gets committed.

# Tier 2 working area - cloned repositories are never committed.
# They are someone else's code, they are ~28 GB at panel scale, and they are
# always re-fetchable from their origin. Only our observations get committed.
data/clones/
